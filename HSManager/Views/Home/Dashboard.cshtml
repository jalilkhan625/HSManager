﻿﻿@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard";
    Layout = null;

    var user = (ClaimsPrincipal)User;
    var token = user.FindFirst("Token")?.Value;
    var userId = user.FindFirst("UserID")?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HSManager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/dashboard.css" rel="stylesheet" />
    <style>
        .sidebar {
            height: calc(100vh - 100px); /* Reduced subtraction to increase height slightly */
            position: absolute;
            top: 80px;
            z-index: 1001;
            width: 60px;
            background-color: #212121;
        }


        .sky-blue-hr {
            border: 0;
            height: 2px;
            background-color: skyblue;
            margin: 0;
        }

        /* Option 1: Using margin-left to push it right */
        .steps-container {
            display: flex;
            gap: 15px;
            font-size: 14px;
            margin-left: 50px; /* Adjust value as needed */
        }

        .step-item {
            display: flex;
            align-items: center;
        }

        .step-number {
            background-color: skyblue;
            color: #1a1a1a;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 5px;
        }

        /* Style for locked state */
        .locked-element {
            pointer-events: none;
            opacity: 0.6;
        }
    </style>
</head>
<body>
    <!-- Div above Navbar (Fixed at Top with Image on Right) -->
    <div id="aboveNavbar" style="background-color: #2a2a2a; height: 80px; width: 100%; position: fixed; top: 0; z-index: 999; display: flex; align-items: center; padding: 0 20px;">
        <img src="/assets/_Loghi/DATALABOR_Hyper Application Platform_logo-negativo.png" alt="Hyperspace Logo" style="height: 280px; width: 380px; margin-left:1150px;" />
    </div>

    <!-- Original Navbar (Moved Downward) -->
   
    <!-- Main Content -->
    <div class="container-fluid" style="background-color: #2a2a2a; min-height: calc(100vh - 110px); padding: 0;">
        <div class="row" style="margin: 0;">
            <!-- Sidebar -->
            <nav class="d-none d-md-block bg-sidebar sidebar">
                <div class="sidebar-sticky pt-3 text-center" style="height: calc(100% - 30px); display: flex; flex-direction: column;">
                    
                    <div class="sidebar-spacer"></div>
                    <ul class="nav flex-column" id="menuList" style="margin-bottom: 0;">
                        <li class="nav-item mb-3">
                            <a class="nav-link text-white" href="#" data-id="1" title="Table Manager">
                                <img src="/assets/main-icons/table-manager.png" alt="Table Manager" width="24" height="24">
                            </a>
                        </li>
                        <hr class="sky-blue-hr" />
                        <li class="nav-item mb-3">
                            <a class="nav-link text-white" href="#" data-id="2" title="InternalUserManager">
                                <img src="/assets/main-icons/user-internal.png" alt="Internal User Manager" width="24" height="24">
                            </a>
                        </li>
                        <li class="nav-item mb-3">
                            <a class="nav-link text-white" href="#" data-id="3" title="ExternalUserManager">
                                <img src="/assets/main-icons/user-external.png" alt="External User Manager" width="24" height="24">
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="bg-sidebar text-white py-2" style="width: 60px; height: 30px; position: absolute; bottom: 0; left: 0;"></div>
            </nav>

            <!-- Main Area -->
            <main role="main">
                <div id="dashboardContent" class="content-area">
                    <h1 class="mt-5 text-center" style="font-size: 1.9rem; margin-top: 6rem !important; position: relative;">Welcome to HSManager Dashboard</h1>
                    <p class="text-center">You're now logged in.</p>

                    <!-- Option 1: Add margin-top directly -->
                    <div id="tableManagerContainer" class="table-manager-container" style="display: none; padding-top: 100px;">
                        <nav id="originalNavbar" class="bg-dark text-white" style="position: fixed; top: 80px; width: 100%; z-index: 1000; margin-left:-20px;">
                            <div class="d-flex justify-content-between align-items-center navbar-top px-3" style="height: 40px;">
                                <div class="d-flex align-items-center">
                                </div>
                                <div id="User-title" style="margin-right: 60px;">Table Manager</div>
                            </div>
                            <hr class="sky-blue-hr" />
                            <div class="d-flex justify-content-between align-items-center navbar-bottom px-3" style="height: 50px;margin-right: 50px">
                                <div id="stepsContainer" class="steps-container text-white" style="flex-grow: 1; display: none; width: 80%; min-width: 600px;"></div>
                                <div style="display: flex; align-items: center; margin-right: 20px; margin-left: auto;">
                                    <img id="lockIcon"
                                         src="/assets/Icons/lock.svg"
                                         alt="Lock"
                                         style="cursor: pointer; filter: brightness(0) invert(1); margin: 0 5px; width: 16px; height: 16px;"
                                         onmouseover="this.style.transform='scale(1.2)'; this.style.transition='transform 0.2s ease';"
                                         onmouseout="this.style.transform='scale(1)';" />
                                    <img id="undoIcon"
                                         src="/assets/Icons/undo.svg"
                                         alt="Refresh"
                                         style="cursor: pointer; filter: brightness(0) invert(1); margin: 0 5px; width: 16px; height: 16px;"
                                         onmouseover="this.style.transform='scale(1.2)'; this.style.transition='transform 0.2s ease';"
                                         onmouseout="this.style.transform='scale(1)';" />
                                    <a href="#"
                                       id="playIcon"
                                       style="display: inline-block;"
                                       onmouseover="this.style.transform='scale(1.2)'; this.style.transition='transform 0.2s ease';"
                                       onmouseout="this.style.transform='scale(1)';" />
                                    <img src="/assets/Icons/play.svg"
                                         alt="Logout"
                                         style="cursor: pointer; filter: brightness(0) invert(1); margin: 0 5px; width: 16px; height: 16px;" />
                                    </a>
                                </div>


                            </div>
                        </nav>


                        <div class="table-manager">
                            <h2>Table Manager</h2>
                            <div class="section-title">
                                <span>Areas</span>
                                <div class="icon-bar">
                                    <img src="/assets/main-icons/move-up.png" id="moveUpAreaBtn" alt="Move Up" />
                                    <img src="/assets/main-icons/move-down.png" id="moveDownAreaBtn" alt="Move Down" />
                                    <img src="/assets/main-icons/add.png" id="addAreaBtn" alt="Add" />
                                    <img src="/assets/main-icons/delete.png" id="deleteAreaBtn" alt="Delete" />
                                </div>
                            </div>
                            <div class="list-box-container">
                                <ul class="custom-list" id="areaList"></ul>
                            </div>
                        </div>
                        <div class="area-details" style="display: none;">
                            <h3>Area Details</h3>
                            <div class="section-title">
                                <span>Tables</span>
                                <div class="icon-bar">
                                    <img src="/assets/main-icons/move-up.png" id="moveUpTableBtn" alt="Move Up" />
                                    <img src="/assets/main-icons/move-down.png" id="moveDownTableBtn" alt="Move Down" />
                                    <img src="/assets/main-icons/add.png" id="addTableBtn" alt="Add" />
                                    <img src="/assets/main-icons/delete.png" id="deleteTableBtn" alt="Delete" />
                                </div>
                            </div>
                            <div class="list-box-container">
                                <ul class="custom-list" id="tableList"></ul>
                            </div>
                        </div>
                        <div class="table-details" style="display: none;">
                            <h3>Table Details</h3>
                            <div class="section-title">
                                <span>Field Groups</span>
                                <div class="icon-bar">
                                    <img src="/assets/main-icons/move-up.png" id="moveUpFieldGroupBtn" alt="Move Up" />
                                    <img src="/assets/main-icons/move-down.png" id="moveDownFieldGroupBtn" alt="Move Down" />
                                    <img src="/assets/main-icons/add.png" id="addFieldGroupBtn" alt="Add" />
                                    <img src="/assets/main-icons/delete.png" id="deleteFieldGroupBtn" alt="Delete" />
                                </div>
                            </div>
                            <div class="list-box-container">
                                <ul class="custom-list" id="fieldGroupList"></ul>
                            </div>
                        </div>
                        <div class="field-details" style="display: none;">
                            <h3>Field Details</h3>
                            <div class="section-title">
                                <span>Fields</span>
                                <div class="icon-bar">
                                    <img src="/assets/main-icons/move-up.png" id="moveUpFieldBtn" alt="Move Up" />
                                    <img src="/assets/main-icons/move-down.png" id="moveDownFieldBtn" alt="Move Down" />
                                    <img src="/assets/main-icons/add.png" id="addFieldBtn" alt="Add" />
                                    <img src="/assets/main-icons/delete.png" id="deleteFieldBtn" alt="Delete" />
                                </div>
                            </div>
                            <div class="list-box-container">
                                <ul class="custom-list" id="fieldList"></ul>
                            </div>
                        </div>
                        <div class="field-settings" style="display: none;">
                            <h3>Field Settings</h3>
                            <!-- Placeholder for settings -->
                        </div>
                        <div class="field-settings-details" style="display: none;">
                            <h3>Field Settings Details</h3>
                            <!-- Placeholder for settings details -->
                        </div>
                    </div>
                </div>
                <div id="configContainer" style="flex: 0;"></div>
            </main>
        </div>

        <!-- Footer -->
        <footer class="bg-sidebar text-white py-2" id="logout-footer"style="position: fixed; bottom: 0; width: 100%; left: 0; height: 30px;">
            <div class="container-fluid d-flex justify-content-end align-items-center" style="padding-right: 15px; position: relative; height: 100%;">
                <div class="logout-container">
                    <a href="#" class="logout-icon" id="logoutToggle">
                        <img src="/assets/Icons/power-off.svg" alt="Logout" width="20" height="20" />
                    </a>
                    <div class="logout-popup" id="logoutPopup">
                        <p><strong>Esci dall'applicazione Hyperspace</strong></p>
                        <p>Confermi l'uscita?</p>
                        <button class="cancel-btn" id="cancelLogout">Annulla</button>
                        <a href="/logout" class="logout-btn">Esci</a>
                    </div>
                </div>
            </div>
        </footer>

        <div id="floatingLabel" class="floating-label">Table Manager</div>
    </div>

    <!-- Hidden Auth Fields -->
    <input type="hidden" id="token" value="@token" />
    <input type="hidden" id="userId" value="@userId" />

    
    <!-- Assuming areaManager.js contains the main logic -->
    <script src="/js/dashboard.js"></script>

    <script>
        const selectedItems = {
            area: null,
            table: null,
            fieldGroup: null,
            field: null
        };
        let isLocked = false;

        function populateSteps() {
            console.log("Populating steps based on selected items:", selectedItems);
            const stepsContainer = document.getElementById("stepsContainer");
            if (!stepsContainer) {
                console.error("Steps container not found");
                return;
            }

            const hasSelection = selectedItems.area || selectedItems.table || selectedItems.fieldGroup || selectedItems.field;
            if (!hasSelection) {
                stepsContainer.style.display = "none";
                return;
            } else {
                stepsContainer.style.display = "flex";
            }

            const steps = [
                selectedItems.area ? `Area: ${selectedItems.area.name}` : "Select an Area",
                selectedItems.table ? `Table: ${selectedItems.table.name}` : (selectedItems.area ? "Select a Table" : "—"),
                selectedItems.fieldGroup ? `Field Group: ${selectedItems.fieldGroup.name}` : (selectedItems.table ? "Select a Field Group" : "—"),
                selectedItems.field ? `Field: ${selectedItems.field.name}` : (selectedItems.fieldGroup ? "Select a Field" : "—")
            ];

            stepsContainer.innerHTML = steps.map((step, index) => `
                <div class="step-item">
                    <span class="step-number">${index + 1}</span>
                    <span>${step}</span>
                </div>
            `).join("");
        }

        // Function to apply lock state to all interactive elements except list items
        function applyLockState() {
            const editableElements = document.querySelectorAll(
                "#tableManagerContainer input, #tableManagerContainer textarea, #tableManagerContainer select, " +
                "#tableManagerContainer button, #tableManagerContainer .icon-bar img"
            );
            if (isLocked) {
                editableElements.forEach(el => {
                    el.classList.add("locked-element");
                    if (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.tagName === "SELECT") {
                        el.disabled = true;
                    }
                });
                console.log("Lock state reapplied to all editable elements");
            }
        }

        // Function to toggle lock state
        function toggleLock() {
            isLocked = !isLocked;
            const lockIcon = document.getElementById("lockIcon");
            const editableElements = document.querySelectorAll(
                "#tableManagerContainer input, #tableManagerContainer textarea, #tableManagerContainer select, " +
                "#tableManagerContainer button, #tableManagerContainer .icon-bar img"
            );

            if (isLocked) {
                lockIcon.src = "/assets/Icons/lock.svg"; // Update to a locked icon if available
                editableElements.forEach(el => {
                    el.classList.add("locked-element");
                    if (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.tagName === "SELECT") {
                        el.disabled = true;
                    }
                });
                console.log("Dashboard locked (list items remain clickable, add/delete/move disabled)");
            } else {
                lockIcon.src = "/assets/Icons/lock.svg"; // Revert to original lock icon
                editableElements.forEach(el => {
                    el.classList.remove("locked-element");
                    if (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.tagName === "SELECT") {
                        el.disabled = false;
                    }
                });
                console.log("Dashboard unlocked");
            }
        }

        // Function to undo new items
        function undoNewItems() {
            console.log("Undoing new items");
            const storageKeys = ["newAreas", "newTables", "newFieldGroups", "newFields"];
            storageKeys.forEach(key => {
                sessionStorage.removeItem(key);
                console.log(`Cleared ${key} from sessionStorage`);
            });

            const tableManagerContainer = document.getElementById("tableManagerContainer");
            if (tableManagerContainer.style.display === "flex") {
                populateAreasList();
                document.querySelector(".area-details").innerHTML = "";
                document.querySelector(".table-details").innerHTML = "";
                document.querySelector(".field-details").innerHTML = "";
                document.querySelector(".field-settings").innerHTML = "";
                document.querySelector(".field-settings-details").innerHTML = "";
                selectedItems.area = null;
                selectedItems.table = null;
                selectedItems.fieldGroup = null;
                selectedItems.field = null;
                populateSteps();
            }
            console.log("Undo completed, UI refreshed");
        }

        // Placeholder functions for actions (to be implemented in areaManager.js)
        function moveUpArea() { console.log("Move up area clicked"); }
        function moveDownArea() { console.log("Move down area clicked"); }
        function addNewArea() { console.log("Add area clicked"); }
        function deleteArea() { console.log("Delete area clicked"); }

        function moveUpTable() { console.log("Move up table clicked"); }
        function moveDownTable() { console.log("Move down table clicked"); }
        function addNewTable() { console.log("Add table clicked"); }
        function deleteTable() { console.log("Delete table clicked"); }

        function moveUpFieldGroup() { console.log("Move up field group clicked"); }
        function moveDownFieldGroup() { console.log("Move down field group clicked"); }
        function addNewFieldGroup() { console.log("Add field group clicked"); }
        function deleteFieldGroup() { console.log("Delete field group clicked"); }

        function moveUpField() { console.log("Move up field clicked"); }
        function moveDownField() { console.log("Move down field clicked"); }
        function addNewField() { console.log("Add field clicked"); }
        function deleteField() { console.log("Delete field clicked"); }

        // Attach listeners defined in areaManager.js
        function attachAreaListListeners() {
            document.querySelectorAll("#areaList .custom-list-item").forEach(item => {
                item.addEventListener("click", async () => {
                    console.log(`Area clicked: ${item.dataset.id}`);
                    document.querySelectorAll("#areaList .custom-list-item").forEach(i => i.classList.remove("selected"));
                    item.classList.add("selected");
                    const areaId = item.dataset.id;
                    selectedItems.area = { id: areaId, name: item.textContent };
                    selectedItems.table = null;
                    selectedItems.fieldGroup = null;
                    selectedItems.field = null;
                    populateSteps();
                    await loadAreaDetails(areaId);
                    applyLockState(); // Reapply lock state after loading new content
                });
            });
        }

        function attachTableListListeners() {
            document.querySelectorAll("#tableList .custom-list-item").forEach(item => {
                item.addEventListener("click", async () => {
                    console.log(`Table clicked: ${item.dataset.id}`);
                    document.querySelectorAll("#tableList .custom-list-item").forEach(i => i.classList.remove("selected"));
                    item.classList.add("selected");
                    const tableId = item.dataset.id;
                    selectedItems.table = { id: tableId, name: item.textContent };
                    selectedItems.fieldGroup = null;
                    selectedItems.field = null;
                    populateSteps();
                    await loadTableDetails(tableId);
                    applyLockState(); // Reapply lock state after loading new content
                });
            });
        }

        function attachFieldGroupListListeners() {
            document.querySelectorAll("#fieldGroupList .custom-list-item").forEach(item => {
                item.addEventListener("click", async () => {
                    console.log(`Field Group clicked: ${item.dataset.id}`);
                    document.querySelectorAll("#fieldGroupList .custom-list-item").forEach(i => i.classList.remove("selected"));
                    item.classList.add("selected");
                    const fieldGroupId = item.dataset.id;
                    selectedItems.fieldGroup = { id: fieldGroupId, name: item.textContent };
                    selectedItems.field = null;
                    populateSteps();
                    await loadFieldGroupDetails(fieldGroupId);
                    applyLockState(); // Reapply lock state after loading new content
                });
            });
        }

        function attachFieldListListeners() {
            document.querySelectorAll("#fieldList .custom-list-item").forEach(item => {
                item.addEventListener("click", async () => {
                    console.log(`Field clicked: ${item.dataset.id}`);
                    document.querySelectorAll("#fieldList .custom-list-item").forEach(i => i.classList.remove("selected"));
                    item.classList.add("selected");
                    const fieldId = item.dataset.id;
                    selectedItems.field = { id: fieldId, name: item.textContent };
                    populateSteps();
                    await loadFieldDetails(fieldId);
                    applyLockState(); // Reapply lock state after loading new content
                });
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            console.log("DOM content loaded, initializing steps and icon listeners");

            // Area button listeners
            document.getElementById("moveUpAreaBtn").addEventListener("click", () => {
                if (!isLocked) moveUpArea();
                else console.log("Move up area blocked due to lock");
            });
            document.getElementById("moveDownAreaBtn").addEventListener("click", () => {
                if (!isLocked) moveDownArea();
                else console.log("Move down area blocked due to lock");
            });
            document.getElementById("addAreaBtn").addEventListener("click", () => {
                if (!isLocked) addNewArea();
                else console.log("Add area blocked due to lock");
            });
            document.getElementById("deleteAreaBtn").addEventListener("click", () => {
                if (!isLocked) deleteArea();
                else console.log("Delete area blocked due to lock");
            });

            // Table button listeners
            document.getElementById("moveUpTableBtn").addEventListener("click", () => {
                if (!isLocked) moveUpTable();
                else console.log("Move up table blocked due to lock");
            });
            document.getElementById("moveDownTableBtn").addEventListener("click", () => {
                if (!isLocked) moveDownTable();
                else console.log("Move down table blocked due to lock");
            });
            document.getElementById("addTableBtn").addEventListener("click", () => {
                if (!isLocked) addNewTable();
                else console.log("Add table blocked due to lock");
            });
            document.getElementById("deleteTableBtn").addEventListener("click", () => {
                if (!isLocked) deleteTable();
                else console.log("Delete table blocked due to lock");
            });

            // Field Group button listeners
            document.getElementById("moveUpFieldGroupBtn").addEventListener("click", () => {
                if (!isLocked) moveUpFieldGroup();
                else console.log("Move up field group blocked due to lock");
            });
            document.getElementById("moveDownFieldGroupBtn").addEventListener("click", () => {
                if (!isLocked) moveDownFieldGroup();
                else console.log("Move down field group blocked due to lock");
            });
            document.getElementById("addFieldGroupBtn").addEventListener("click", () => {
                if (!isLocked) addNewFieldGroup();
                else console.log("Add field group blocked due to lock");
            });
            document.getElementById("deleteFieldGroupBtn").addEventListener("click", () => {
                if (!isLocked) deleteFieldGroup();
                else console.log("Delete field group blocked due to lock");
            });

            // Field button listeners
            document.getElementById("moveUpFieldBtn").addEventListener("click", () => {
                if (!isLocked) moveUpField();
                else console.log("Move up field blocked due to lock");
            });
            document.getElementById("moveDownFieldBtn").addEventListener("click", () => {
                if (!isLocked) moveDownField();
                else console.log("Move down field blocked due to lock");
            });
            document.getElementById("addFieldBtn").addEventListener("click", () => {
                if (!isLocked) addNewField();
                else console.log("Add field blocked due to lock");
            });
            document.getElementById("deleteFieldBtn").addEventListener("click", () => {
                if (!isLocked) deleteField();
                else console.log("Delete field blocked due to lock");
            });

            // Lock icon listener
            document.getElementById("lockIcon").addEventListener("click", () => {
                toggleLock();
            });

            // Undo icon listener
            document.getElementById("undoIcon").addEventListener("click", () => {
                if (!isLocked) undoNewItems();
                else console.log("Undo blocked due to lock");
            });

            populateSteps();
        });




        // Watch for dynamic additions to the sidebar
        const sidebar = document.querySelector('.sidebar'); // Adjust selector to your sidebar's class or ID
        if (sidebar) {
            const observer = new MutationObserver(function(mutations) {
                const navLink = document.querySelector('a.nav-link[data-id="1"]');
                if (navLink) {
                    const dynamicImage = navLink.querySelector('img');
                    if (dynamicImage && !dynamicImage.dataset.listenerAdded) { // Prevent duplicate listeners
                        dynamicImage.addEventListener("click", function(event) {
                            event.preventDefault();
                            showElementsOnClick();
                        });
                        dynamicImage.dataset.listenerAdded = "true"; // Mark as processed
                    }
                }
            });
            observer.observe(sidebar, { childList: true, subtree: true });
        }



    </script>
    
</body>
</html>